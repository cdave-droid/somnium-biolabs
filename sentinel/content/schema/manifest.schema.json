{
  "$id": "manifest.schema.json",
  "title": "ContentManifest",
  "type": "object",
  "required": ["content_type", "package_version", "min_engine_version", "signing", "files", "package_hash"],
  "additionalProperties": false,
  "properties": {
    "content_type": { "type": "string", "enum": ["manifest"] },
    "package_version": { "type": "string", "minLength": 1 },
    "min_engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "signing": {
      "type": "object",
      "required": ["algorithm"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "type": "string", "enum": ["none", "ed25519"] },
        "public_key": { "type": "string" },
        "signature": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "package_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
