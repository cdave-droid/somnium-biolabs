{
  "$id": "observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": ["obs_id", "unit_id", "timestamp", "type", "source"],
  "additionalProperties": false,
  "properties": {
    "obs_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "type": {
      "type": "string",
      "enum": ["cycle_rate", "flow_rate", "saturation_pct", "pressure_primary", "pressure_secondary", "temperature_c", "responsiveness", "strain_0_10", "mass_kg", "reserve_level", "event", "free_text_note"]
    },
    "value": {},
    "unit": { "type": "string" },
    "event_id": { "type": "string" },
    "text": { "type": "string" },
    "source": {
      "type": "string",
      "enum": ["wearable_sensor", "inline_gauge", "manual_entry", "fixed_monitor", "event_report"]
    },
    "quality_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_s": { "type": "number", "minimum": 0 },
        "waveform_available": { "type": "boolean" },
        "noise_flag": { "type": ["boolean", "null"] }
      }
    }
  }
}
